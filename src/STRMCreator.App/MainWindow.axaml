<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:STRMCreator.App"
        x:Class="STRMCreator.App.MainWindow"
        x:CompileBindings="False"
        Title="STRM Creator" Width="1180" Height="760"
        MinWidth="900" MinHeight="620"
        Background="#F4F5F7">
  <Window.Styles>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#50545B"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="14,6"/>
    </Style>
    <Style Selector="Button.topbar">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="Foreground" Value="#181B20"/>
      <Setter Property="BorderBrush" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.topbar:pointerover">
      <Setter Property="Background" Value="#E2E5E9"/>
      <Setter Property="Foreground" Value="#181B20"/>
      <Setter Property="BorderBrush" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.topbar /template/ ContentPresenter">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="Foreground" Value="#181B20"/>
    </Style>
    <Style Selector="Button.topbar:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E2E5E9"/>
      <Setter Property="Foreground" Value="#181B20"/>
    </Style>
    <Style Selector="ComboBox#TitleBox /template/ TextBox#PART_EditableTextBox">
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox, ComboBox">
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D9DCE1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">
    <Border Background="#20242A" Padding="20,14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="STRM Creator" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Библиотека TorrServer для Infuse" Foreground="#B9BEC6" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="topbar" Content="Добавить magnet" Click="OpenMagnet_Click"/>
          <Button Classes="topbar" Content="Открыть torrent" Click="OpenTorrent_Click"/>
          <Button x:Name="SettingsToggle" Classes="topbar" Content="Настройки"
                  BorderThickness="1"
                  Click="SettingsToggle_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="330,*" Margin="16" ColumnSpacing="14">
      <Border Classes="panel">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Margin="16,14,16,10" Spacing="8">
            <TextBlock Classes="h1" Text="Медиатека"/>
            <TextBlock x:Name="LibraryCountText" Classes="label" Text="0 источников"/>
            <TextBox x:Name="LibrarySearchBox" PlaceholderText="Поиск"
                     TextChanged="LibrarySearch_Changed"/>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
              <Button x:Name="ShowAllButton" Padding="8,4"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center" Click="ShowAll_Click">
                <TextBlock Text="Все" TextAlignment="Center" HorizontalAlignment="Center"/>
              </Button>
              <Button x:Name="ShowMoviesButton" Grid.Column="1" Padding="8,4"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center" Click="ShowMovies_Click">
                <TextBlock Text="Фильмы" TextAlignment="Center" HorizontalAlignment="Center"/>
              </Button>
              <Button x:Name="ShowSeriesButton" Grid.Column="2" Padding="8,4"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center" Click="ShowSeries_Click">
                <TextBlock Text="Сериалы" TextAlignment="Center" HorizontalAlignment="Center"/>
              </Button>
            </Grid>
          </StackPanel>
          <ListBox x:Name="LibraryList" Grid.Row="1" Margin="8,0"
                   SelectionChanged="LibraryList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="8,8" ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detail}" Classes="label"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="label" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border Grid.Row="2" BorderBrush="#E2E4E8" BorderThickness="0,1,0,0" Padding="12">
            <Button Content="Синхронизировать всю медиатеку" HorizontalAlignment="Stretch"
                    Click="SyncAll_Click"/>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="panel">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid Margin="20,16">
            <StackPanel>
              <TextBlock x:Name="EditorTitleText" Classes="h1" Text="Добавление источника"/>
              <TextBlock x:Name="TorrentSummaryText" Classes="label"
                         Text="Выберите torrent-файл, чтобы увидеть его содержимое"/>
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Background="#F7F8FA" BorderBrush="#E2E4E8"
                  BorderThickness="0,1" Padding="20,14">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,100,100"
                  ColumnSpacing="14" RowSpacing="12">
              <StackPanel Grid.ColumnSpan="4">
                <TextBlock Classes="label" Text="Название"/>
                <ComboBox x:Name="TitleBox" IsEditable="True" IsTextSearchEnabled="False"
                          VerticalContentAlignment="Center"
                          SelectionChanged="TitleBox_SelectionChanged"/>
              </StackPanel>
              <StackPanel Grid.Row="1">
                <TextBlock Classes="label" Text="Категория"/>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                  <RadioButton x:Name="SeriesKindRadio" Content="Сериал" IsChecked="True"
                               Click="MediaKind_Changed"/>
                  <RadioButton x:Name="MovieKindRadio" Content="Фильм" Click="MediaKind_Changed"/>
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="SeasonControls" Grid.Row="1" Grid.Column="2">
                <TextBlock Classes="label" Text="Сезон"/>
                <local:NumberStepper x:Name="SeasonBox" Minimum="0" Maximum="999" Value="1"
                                     ValueChanged="Numbering_Changed"/>
              </StackPanel>
              <StackPanel x:Name="EpisodeControls" Grid.Row="1" Grid.Column="3">
                <TextBlock Classes="label" Text="Первая серия"/>
                <local:NumberStepper x:Name="FirstEpisodeBox" Minimum="0" Maximum="9999" Value="1"
                                     ValueChanged="Numbering_Changed"/>
              </StackPanel>
            </Grid>
          </Border>

          <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto">
            <Grid Margin="20,14,20,8" ColumnDefinitions="70,*,65,95,95,210">
              <TextBlock Text="Включить" Classes="label"/>
              <TextBlock Grid.Column="1" Text="Исходный файл" Classes="label"/>
              <TextBlock Grid.Column="2" Text="Индекс" Classes="label"/>
              <TextBlock x:Name="SeasonColumnHeader" Grid.Column="3" Text="Сезон" Classes="label"/>
              <TextBlock x:Name="EpisodeColumnHeader" Grid.Column="4" Text="Серия" Classes="label"/>
              <TextBlock Grid.Column="5" Text="Итоговый STRM" Classes="label"/>
            </Grid>
            <ListBox x:Name="EpisodeList" Grid.Row="1" Margin="12,0">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="8,5" ColumnDefinitions="70,*,65,95,95,210">
                    <CheckBox IsChecked="{Binding Selected}"/>
                    <TextBlock Grid.Column="1" Text="{Binding SourceName}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Index}" VerticalAlignment="Center"/>
                    <local:NumberStepper Grid.Column="3" Value="{Binding Season, Mode=TwoWay}"
                                         Minimum="0" Maximum="999" MinHeight="30"
                                         IsVisible="{Binding IsSeries}"/>
                    <local:NumberStepper Grid.Column="4" Value="{Binding Episode, Mode=TwoWay}"
                                         Minimum="0" Maximum="9999" MinHeight="30"
                                         IsVisible="{Binding IsSeries}"/>
                    <TextBlock Grid.Column="5" Text="{Binding OutputName}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Row="2" BorderBrush="#E2E4E8" BorderThickness="0,1,0,0" Padding="20,12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="StatusText" Text="Готово" Classes="label" VerticalAlignment="Center"/>
                <Button x:Name="ImportButton" Grid.Column="1" Content="Добавить и синхронизировать"
                        IsVisible="False"
                        Click="ImportAndSync_Click"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
