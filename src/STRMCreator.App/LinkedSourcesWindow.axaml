<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:STRMCreator.App.Localization"
        x:Class="STRMCreator.App.LinkedSourcesWindow"
        x:CompileBindings="False"
        Title="{i18n:Loc TorrentsAndLinks}" Width="780" Height="560"
        MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#F4F5F7">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Background="#20242A" Padding="22,16">
      <StackPanel>
        <TextBlock Text="{i18n:Loc LinkedTorrentSources}" Foreground="White"
                   FontSize="21" FontWeight="SemiBold"/>
        <TextBlock x:Name="TitleText" Foreground="#B9BEC6"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Background="White" BorderBrush="#D9DCE1"
            BorderThickness="0,0,0,1" Padding="16,12">
      <TextBox x:Name="SourceSearchBox"
               PlaceholderText="{i18n:Loc SourceSearchHint}"
               TextChanged="SourceSearch_Changed"/>
    </Border>
    <ListBox x:Name="SourcesList" Grid.Row="2" Margin="16">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="10,8" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Hash}" Foreground="#5A5F67" FontSize="12"/>
              <TextBlock Text="{Binding Detail}" Foreground="#5A5F67" FontSize="12"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Storage}" VerticalAlignment="Center"
                       Foreground="#347044"/>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Border Grid.Row="3" Background="White" BorderBrush="#D9DCE1"
            BorderThickness="0,1,0,0" Padding="16">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <StackPanel>
            <TextBlock Text="{i18n:Loc Category}" Foreground="#50545B" FontSize="12"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <RadioButton x:Name="TargetSeriesRadio" Content="{i18n:Loc Series}" IsChecked="True"
                           Click="TargetKind_Changed"/>
              <RadioButton x:Name="TargetMovieRadio" Content="{i18n:Loc Movie}"
                           Click="TargetKind_Changed"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{i18n:Loc RelinkSelected}"
                       Foreground="#50545B" FontSize="12"/>
            <ComboBox x:Name="TargetTitleBox" IsEditable="True"
                      IsTextSearchEnabled="True" MinHeight="38"/>
          </StackPanel>
          <Button Grid.Column="2" Content="{i18n:Loc Relink}" VerticalAlignment="Bottom"
                  Click="Reassign_Click"/>
        </Grid>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8">
          <Button Content="{i18n:Loc Close}" Click="Close_Click"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
