<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:STRMCreator.App.Localization"
        x:Class="STRMCreator.App.MagnetDialog"
        Title="{i18n:Loc MagnetTitle}" Width="680" Height="230"
        MinWidth="520" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#F4F5F7">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20" RowSpacing="10">
    <StackPanel>
      <TextBlock Text="{i18n:Loc MagnetLink}" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="{i18n:Loc MagnetHint}"
                 Foreground="#5A5F67" FontSize="12"/>
    </StackPanel>
    <TextBox x:Name="MagnetTextBox" Grid.Row="1" AcceptsReturn="True"
             TextWrapping="Wrap" PlaceholderText="magnet:?xt=urn:btih:..."/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="{i18n:Loc Cancel}" Click="Cancel_Click"/>
      <Button Content="{i18n:Loc GetMetadata}" Click="Accept_Click"/>
    </StackPanel>
  </Grid>
</Window>
