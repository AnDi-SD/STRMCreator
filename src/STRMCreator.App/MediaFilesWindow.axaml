<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:STRMCreator.App.Localization"
        xmlns:local="using:STRMCreator.App"
        x:Class="STRMCreator.App.MediaFilesWindow"
        x:CompileBindings="False"
        Title="{i18n:Loc MediaAssignment}" Width="980" Height="650"
        MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="#F4F5F7">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Background="#20242A" Padding="22,16">
      <StackPanel>
        <TextBlock Text="{i18n:Loc MediaAssignment}" Foreground="White"
                   FontSize="21" FontWeight="SemiBold"/>
        <TextBlock x:Name="TitleText" Foreground="#B9BEC6"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Background="#F7F8FA" Padding="18,10"
            BorderBrush="#D9DCE1" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="75,*,190,75,Auto,Auto">
        <TextBlock Text="{i18n:Loc Include}" Foreground="#50545B" FontSize="12"/>
        <TextBlock Grid.Column="1" Text="{i18n:Loc File}" Foreground="#50545B" FontSize="12"/>
        <TextBlock Grid.Column="2" Text="{i18n:Loc Source}" Foreground="#50545B" FontSize="12"/>
        <TextBlock Grid.Column="3" Text="{i18n:Loc Index}" Foreground="#50545B" FontSize="12"
                   TextAlignment="Center"/>
        <TextBlock x:Name="SeasonHeader" Grid.Column="4" Text="{i18n:Loc Season}"
                   Foreground="#50545B" FontSize="12" TextAlignment="Center" Width="110"/>
        <TextBlock x:Name="EpisodeHeader" Grid.Column="5" Text="{i18n:Loc Episode}"
                   Foreground="#50545B" FontSize="12" TextAlignment="Center" Width="110"/>
      </Grid>
    </Border>
    <ListBox x:Name="FilesList" Grid.Row="2" Margin="10,0">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="8,5" ColumnDefinitions="75,*,190,75,Auto,Auto">
            <CheckBox IsChecked="{Binding Selected}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding SourceName}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="{Binding Index}" TextAlignment="Center"
                       VerticalAlignment="Center"/>
            <local:NumberStepper Grid.Column="4" Value="{Binding Season, Mode=TwoWay}"
                                 Minimum="0" Maximum="999" Width="110"
                                 IsVisible="{Binding IsSeries}"/>
            <local:NumberStepper Grid.Column="5" Value="{Binding Episode, Mode=TwoWay}"
                                 Minimum="0" Maximum="9999" Width="110"
                                 IsVisible="{Binding IsSeries}"/>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Border Grid.Row="3" Background="White" BorderBrush="#D9DCE1"
            BorderThickness="0,1,0,0" Padding="18,12">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBlock x:Name="StatusText" Foreground="#5A5F67" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="{i18n:Loc Cancel}" Click="Cancel_Click"/>
        <Button Grid.Column="2" Content="{i18n:Loc ApplyAssignment}" Click="Save_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>
