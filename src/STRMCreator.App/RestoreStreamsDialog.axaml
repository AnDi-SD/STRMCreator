<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:STRMCreator.App.Localization"
        x:Class="STRMCreator.App.RestoreStreamsDialog"
        Title="{i18n:Loc RestoreStrmTitle}" Width="520" Height="235"
        MinWidth="480" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#F4F5F7">
  <Grid RowDefinitions="*,Auto" Margin="22">
    <StackPanel Spacing="10">
      <TextBlock Text="{i18n:Loc MissingStrm}"
                 FontSize="19" FontWeight="SemiBold"/>
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#454A52"/>
      <Border Background="#FFF4D6" BorderBrush="#D8A72E" BorderThickness="1"
              CornerRadius="4" Padding="12">
        <TextBlock Text="{i18n:Loc RestoreStrmHint}"
                   TextWrapping="Wrap" Foreground="#5B4300"/>
      </Border>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="{i18n:Loc Later}" Click="Later_Click"/>
      <Button Content="{i18n:Loc Restore}" Click="Restore_Click"/>
    </StackPanel>
  </Grid>
</Window>
