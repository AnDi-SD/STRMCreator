<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="STRMCreator.App.SyncSettingsDialog"
        Title="Синхронизация медиатеки" Width="520" Height="240"
        MinWidth="480" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#F4F5F7">
  <Grid RowDefinitions="*,Auto" Margin="22">
    <StackPanel Spacing="10">
      <TextBlock Text="Синхронизировать медиатеку сейчас?"
                 FontSize="19" FontWeight="SemiBold"/>
      <TextBlock Text="Изменения адреса TorrServer и путей должны быть применены к существующим STRM-файлам."
                 TextWrapping="Wrap" Foreground="#454A52"/>
      <Border Background="#FFF4D6" BorderBrush="#D8A72E" BorderThickness="1"
              CornerRadius="4" Padding="12">
        <TextBlock Text="Если выбрать «Позже», потребуется вручную запустить синхронизацию медиатеки."
                   TextWrapping="Wrap" Foreground="#5B4300"/>
      </Border>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Отмена" Click="Cancel_Click"/>
      <Button Content="Позже" Click="Later_Click"/>
      <Button Content="Синхронизировать сейчас" Click="Sync_Click"/>
    </StackPanel>
  </Grid>
</Window>
