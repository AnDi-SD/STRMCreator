<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="STRMshelf.App.App"
             RequestedThemeVariant="Light">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button /template/ ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.topbar">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#181B20"/>
        </Style>
        <Style Selector="Button.topbar:pointerover">
            <Setter Property="Background" Value="#E2E5E9"/>
            <Setter Property="Foreground" Value="#181B20"/>
        </Style>
        <Style Selector="Button.topbar:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E2E5E9"/>
            <Setter Property="Foreground" Value="#181B20"/>
        </Style>
    </Application.Styles>
</Application>
