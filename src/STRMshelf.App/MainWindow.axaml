<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:STRMshelf.App"
        xmlns:i18n="using:STRMshelf.App.Localization"
        x:Class="STRMshelf.App.MainWindow"
        x:CompileBindings="False"
        Title="STRMshelf" Width="1180" Height="760"
        Icon="/Assets/app-icon-512.png"
        MinWidth="900" MinHeight="620"
        Background="#F4F5F7">
  <Window.Styles>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#50545B"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="14,6"/>
    </Style>
    <Style Selector="Button.topbar">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="Foreground" Value="#181B20"/>
      <Setter Property="BorderBrush" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.topbar:pointerover">
      <Setter Property="Background" Value="#E2E5E9"/>
      <Setter Property="Foreground" Value="#181B20"/>
      <Setter Property="BorderBrush" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.topbar /template/ ContentPresenter">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="Foreground" Value="#181B20"/>
    </Style>
    <Style Selector="Button.topbar:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E2E5E9"/>
      <Setter Property="Foreground" Value="#181B20"/>
    </Style>
    <Style Selector="TextBox, ComboBox">
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D9DCE1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">
    <Border Background="#20242A" Padding="20,14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="STRMshelf" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="{i18n:Loc AppSubtitle}" Foreground="#B9BEC6" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="topbar" Content="{i18n:Loc AddSource}" Click="AddSource_Click"/>
          <Button Classes="topbar" Content="{i18n:Loc TorrentsAndLinks}" Click="ShowAllSources_Click"/>
          <Button x:Name="SettingsToggle" Classes="topbar" Content="{i18n:Loc Settings}"
                  BorderThickness="1"
                  Click="SettingsToggle_Click"/>
          <Button x:Name="LanguageButton" Classes="topbar" MinWidth="92"
                  BorderThickness="1" Click="Language_Click">
            <Grid>
              <StackPanel x:Name="EnglishLanguageContent" Orientation="Horizontal"
                          Spacing="8" VerticalAlignment="Center">
                <Border Width="24" Height="16" Background="#21468B"
                        ClipToBounds="True" CornerRadius="1">
                  <Grid>
                    <Border Width="7" Background="White"/>
                    <Border Height="7" Background="White"/>
                    <Border Width="3" Background="#C8102E"/>
                    <Border Height="3" Background="#C8102E"/>
                  </Grid>
                </Border>
                <TextBlock Text="EN" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel x:Name="RussianLanguageContent" Orientation="Horizontal"
                          Spacing="8" VerticalAlignment="Center">
                <Border Width="24" Height="16" BorderBrush="#C9CDD3"
                        BorderThickness="0.5" ClipToBounds="True" CornerRadius="1">
                  <Grid RowDefinitions="*,*,*">
                    <Border Background="White"/>
                    <Border Grid.Row="1" Background="#1955A6"/>
                    <Border Grid.Row="2" Background="#D52B1E"/>
                  </Grid>
                </Border>
                <TextBlock Text="RU" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="330,*" Margin="16" ColumnSpacing="14">
      <Border Classes="panel">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Margin="16,14,16,10" Spacing="8">
            <TextBlock Classes="h1" Text="{i18n:Loc Library}"/>
            <TextBlock x:Name="LibraryCountText" Classes="label"/>
            <TextBox x:Name="LibrarySearchBox" PlaceholderText="{i18n:Loc Search}"
                     TextChanged="LibrarySearch_Changed"/>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
              <Button x:Name="ShowAllButton" Padding="8,4"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center" Click="ShowAll_Click">
                <TextBlock Text="{i18n:Loc All}" TextAlignment="Center" HorizontalAlignment="Center"/>
              </Button>
              <Button x:Name="ShowMoviesButton" Grid.Column="1" Padding="8,4"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center" Click="ShowMovies_Click">
                <TextBlock Text="{i18n:Loc Movies}" TextAlignment="Center" HorizontalAlignment="Center"/>
              </Button>
              <Button x:Name="ShowSeriesButton" Grid.Column="2" Padding="8,4"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center" Click="ShowSeries_Click">
                <TextBlock Text="{i18n:Loc SeriesPlural}" TextAlignment="Center" HorizontalAlignment="Center"/>
              </Button>
            </Grid>
          </StackPanel>
          <ListBox x:Name="LibraryList" Grid.Row="1" Margin="8,0"
                   SelectionChanged="LibraryList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="8,10">
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{i18n:Loc DeleteFromLibrary}"
                                Click="DeleteLibraryItem_Click"/>
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border Grid.Row="2" BorderBrush="#E2E4E8" BorderThickness="0,1,0,0" Padding="12">
            <StackPanel Spacing="8">
              <Button x:Name="DeleteSelectedButton" Content="{i18n:Loc DeleteSelected}"
                      HorizontalAlignment="Stretch" IsEnabled="False"
                      Background="#F4E1DF" Foreground="#7B2018"
                      Click="DeleteSelected_Click"/>
              <Button Content="{i18n:Loc SyncEntireLibrary}" HorizontalAlignment="Stretch"
                      Click="SyncAll_Click"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="panel">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid Margin="20,16">
            <StackPanel>
              <TextBlock x:Name="EditorTitleText" Classes="h1"/>
              <TextBlock x:Name="TorrentSummaryText" Classes="label"
                         Text="{i18n:Loc EditorHint}"/>
            </StackPanel>
          </Grid>

          <Border x:Name="EditorFieldsPanel" Grid.Row="1" Background="#F7F8FA"
                  BorderBrush="#E2E4E8" BorderThickness="0,1" Padding="20,14"
                  IsVisible="False">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
              <StackPanel>
                <TextBlock Classes="label" Text="{i18n:Loc TitleLabel}"/>
                <TextBox x:Name="TitleBox" VerticalContentAlignment="Center"
                         TextChanged="TitleBox_TextChanged"/>
              </StackPanel>
              <WrapPanel Grid.Row="1" Orientation="Horizontal">
                <StackPanel Width="220" Margin="0,0,10,10">
                  <TextBlock Classes="label" Text="{i18n:Loc Category}"/>
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                    <RadioButton x:Name="SeriesKindRadio" Content="{i18n:Loc Series}" IsChecked="True"
                                 Click="MediaKind_Changed"/>
                    <RadioButton x:Name="MovieKindRadio" Content="{i18n:Loc Movie}" Click="MediaKind_Changed"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Width="230" Margin="0,0,10,10">
                  <TextBlock Classes="label" Text="{i18n:Loc Playback}"/>
                  <Button x:Name="PlaySeasonButton" Content="{i18n:Loc PlaySeason}"
                          Height="40" HorizontalAlignment="Stretch"
                          Click="PlaySeason_Click"/>
                </StackPanel>
                <StackPanel x:Name="SeasonControls" Width="130" Margin="0,0,10,10">
                  <TextBlock Classes="label" Text="{i18n:Loc Season}"/>
                  <ComboBox x:Name="SeasonSelector" MinHeight="40"
                            SelectionChanged="SeasonSelector_Changed"/>
                </StackPanel>
                <StackPanel x:Name="EpisodeControls" Width="320" Margin="0,0,0,10">
                  <TextBlock Classes="label" Text="{i18n:Loc Management}"/>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                    <Button Content="{i18n:Loc Sources}" Height="40" HorizontalAlignment="Stretch"
                            Click="ShowSources_Click"/>
                    <Button Grid.Column="1" Content="{i18n:Loc MediaFiles}" Height="40"
                            HorizontalAlignment="Stretch" Click="ShowMediaFiles_Click"/>
                  </Grid>
                </StackPanel>
              </WrapPanel>
            </Grid>
          </Border>

          <Grid x:Name="EditorContentPanel" Grid.Row="2" RowDefinitions="Auto,*,Auto"
                IsVisible="False">
            <Grid Margin="20,14,20,8" ColumnDefinitions="46,*,65,95,95,210,86">
              <TextBlock Grid.Column="1" Text="{i18n:Loc SourceFile}" Classes="label"/>
              <TextBlock Grid.Column="2" Text="{i18n:Loc Index}" Classes="label" TextAlignment="Center"/>
              <TextBlock x:Name="SeasonColumnHeader" Grid.Column="3" Text="{i18n:Loc Season}"
                         Classes="label" TextAlignment="Center"/>
              <TextBlock x:Name="EpisodeColumnHeader" Grid.Column="4" Text="{i18n:Loc Episode}"
                         Classes="label" TextAlignment="Center"/>
              <TextBlock Grid.Column="5" Text="{i18n:Loc ResultStrm}" Classes="label"/>
              <TextBlock Grid.Column="6" Text="{i18n:Loc Action}" Classes="label"
                         TextAlignment="Center"/>
            </Grid>
            <ListBox x:Name="EpisodeList" Grid.Row="1" Margin="12,0">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="8,5" ColumnDefinitions="46,*,65,95,95,210,86">
                    <Grid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{i18n:Loc DeleteEpisode}" IsVisible="{Binding IsSeries}"
                                  Click="DeleteEpisodeMenu_Click"/>
                      </ContextMenu>
                    </Grid.ContextMenu>
                    <Button Content="▶" Width="36" Height="34" Padding="0"
                            ToolTip.Tip="{i18n:Loc Play}"
                            Click="PlayEpisode_Click"/>
                    <TextBlock Grid.Column="1" Text="{Binding SourceName}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Index}" VerticalAlignment="Center"
                               TextAlignment="Center"/>
                    <local:NumberStepper Grid.Column="3" Value="{Binding Season, Mode=TwoWay}"
                                         Minimum="0" Maximum="999" MinHeight="30"
                                         IsVisible="{Binding IsSeries}"/>
                    <local:NumberStepper Grid.Column="4" Value="{Binding Episode, Mode=TwoWay}"
                                         Minimum="0" Maximum="9999" MinHeight="30"
                                         IsVisible="{Binding IsSeries}"/>
                    <TextBlock Grid.Column="5" Text="{Binding OutputName}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="6" Content="{i18n:Loc Delete}" Padding="8,4"
                            Background="#F4E1DF" Foreground="#7B2018"
                            IsVisible="{Binding IsSeries}" Click="DeleteEpisode_Click"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Row="2" BorderBrush="#E2E4E8" BorderThickness="0,1,0,0" Padding="20,12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="StatusText" Text="{i18n:Loc Ready}" Classes="label" VerticalAlignment="Center"/>
                <Button x:Name="ImportButton" Grid.Column="1" Content="{i18n:Loc AddAndSync}"
                        IsVisible="False"
                        Click="ImportAndSync_Click"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
